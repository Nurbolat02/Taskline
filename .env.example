# Строка подключения к Postgres, поднятому через `docker compose up -d`.
# Порт 5433, а не стандартный 5432 — чтобы не конфликтовать с локально
# установленным Postgres, если он у тебя уже где-то слушает 5432.
DATABASE_URL="postgres://postgres:123456@localhost:5433/learn_fullstack"

# Секрет для подписи JWT. Для учебного проекта сгенерируй любую длинную случайную строку,
# например: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-long-random-string"
