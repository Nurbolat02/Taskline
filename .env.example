# Connection string for the Postgres instance started via `docker compose up -d`.
# Port 5433, not the standard 5432 — so it doesn't clash with a locally
# installed Postgres if you already have one listening on 5432.
DATABASE_URL="postgres://postgres:123456@localhost:5433/learn_fullstack"

# Secret used to sign JWTs. For a learning project, generate any long random string,
# e.g.: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-long-random-string"
